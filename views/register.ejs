<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | BookNest</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-badge">✨ Start your journal</div>
        <h1>Create your account</h1>
        <p>Build your own cozy reading library in minutes.</p>

        <form action="/register" method="POST" enctype="multipart/form-data" class="auth-form">
            <label>Full Name</label>
            <input type="text" name="name" placeholder="Enter your full name" required>

            <label>Email</label>
            <input type="email" name="email" placeholder="your@email.com" required>

            <label>Password</label>
            <input type="password" name="password" placeholder="Choose a strong password" required>

            <label>Profile Picture</label>
            <input type="file" name="profile_picture" accept="image/*">
            <input type="url" name="profile_picture_url" placeholder="https://example.com/photo.jpg">

            <button type="submit">Create Account</button>
        </form>

        <a href="/auth/google" class="auth-google-btn">Continue with Google</a>

        <p class="auth-link">
            Already have an account?
            <a href="/login">Login</a>
        </p>
    </div>
</div>

<script src="/js/script.js"></script>
</body>
</html>