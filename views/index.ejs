<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookNest | Your Personal Reading Journal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav>

        <a href="/" class="logo" aria-label="Book Nest home">
            <img src="/images/logo.png" alt="Book Nest logo" class="logo-image">
            <span class="logo-text">Book Nest</span>
        </a>

        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/genres">My Shelves</a></li>
            <li><a href="/profile">Profile</a></li>
        </ul>

    </nav>

    <main class="hero">

        <div class="hero-text">

            <span class="badge">
                Your Personal Reading Journal
            </span>

            <h1>
                Every Book Tells a Story.<br>
                Keep Track of Yours.
            </h1>

            <p>
                Organize your books, save reviews, collect favorite quotes,
                monitor your reading journey, and build your own digital library.
            </p>

            <a href="/login" class="btn">
                Begin Your Journey →
            </a>

        </div>

        <div class="hero-image">

            <div class="carousel" aria-label="Featured book images">
                <img class="carousel-image active" src="/images/1.jpg" alt="Stack of books representing your digital library">
                <img class="carousel-image" src="/images/2.jpg" alt="Cozy reading corner with books">
                <img class="carousel-image" src="/images/3.jpg" alt="Open book with a cup of coffee">
                <img class="carousel-image" src="/images/4.jpg" alt="Bookshelf filled with various books">
                <img class="carousel-image" src="/images/5.jpg" alt="Person reading a book in a park">
            </div>

        </div>

    </main>

    <script src="/js/script.js"></script>

</body>
</html>